# Bank Extractor Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# General settings
LOG_LEVEL=INFO
DATA_DIR=./data

# Browser settings
HEADLESS=false
BROWSER_TIMEOUT=30000

# Email settings (for invoice download - Phase 2)
# GMAIL_USER=your-email@gmail.com
# HOTMAIL_USER=your-email@hotmail.com

# Accountant email (for monthly reports - Phase 4)
# ACCOUNTANT_EMAIL=contabilista@example.com
